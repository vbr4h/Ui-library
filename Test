                    local svBox = New("Frame", {
                        Size             = UDim2.fromOffset(190, 120),
                        Position         = UDim2.fromOffset(15, 12),
                        BackgroundColor3 = hsvToColor3(h, 1, 1),
                        BorderSizePixel  = 0,
                        ZIndex           = 51,
                        ClipsDescendants = true,
                    }, picker)
                    Corner(svBox, 6)

                    -- white left-to-right
                    local svWhite = New("Frame", {
                        Size               = UDim2.fromScale(1, 1),
                        BackgroundColor3   = Color3.new(1, 1, 1),
                        BackgroundTransparency = 0,
                        BorderSizePixel    = 0,
                        ZIndex             = 52,
                    }, svBox)
                    local svWhiteGrad = New("UIGradient", {
                        Color     = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1,0)), -- white to transparent
                        Transparency = NumberSequence.new(0, 1),
                    }, svWhite)
                    -- actually do a color gradient properly
                    svWhiteGrad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                        ColorSequenceKeypoint.new(1, Color3.new(1,1,1)),
                    })
                    svWhiteGrad.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(1, 1),
                    })

                    -- black bottom-to-top  
                    local svBlack = New("Frame", {
                        Size               = UDim2.fromScale(1, 1),
                        BackgroundColor3   = Color3.new(0, 0, 0),
                        BackgroundTransparency = 0,
                        BorderSizePixel    = 0,
                        ZIndex             = 53,
                    }, svBox)
                    local svBlackGrad = New("UIGradient", {
                        Rotation     = 90,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1),
                            NumberSequenceKeypoint.new(1, 0),
                        }),
                    }, svBlack)

                    local svThumb = New("Frame", {
                        Size             = UDim2.fromOffset(10, 10),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderSizePixel  = 0,
                        ZIndex           = 55,
                        AnchorPoint      = Vector2.new(0.5, 0.5),
                        Position         = UDim2.new(s, 0, 1 - v, 0),
                    }, svBox)
                    Corner(svThumb, 5)
                    Stroke(svThumb, Color3.new(0,0,0), 1)

                    -- Hue bar
                    local hueBar = New("Frame", {
                        Size             = UDim2.fromOffset(190, 12),
                        Position         = UDim2.fromOffset(15, 140),
                        BorderSizePixel  = 0,
                        ZIndex           = 51,
                        ClipsDescendants = true,
                    }, picker)
                    Corner(hueBar, 6)

                    New("UIGradient", {
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0/6,  Color3.fromRGB(255, 0,   0)),
                            ColorSequenceKeypoint.new(1/6,  Color3.fromRGB(255, 255, 0)),
                            ColorSequenceKeypoint.new(2/6,  Color3.fromRGB(0,   255, 0)),
                            ColorSequenceKeypoint.new(3/6,  Color3.fromRGB(0,   255, 255)),
                            ColorSequenceKeypoint.new(4/6,  Color3.fromRGB(0,   0,   255)),
                            ColorSequenceKeypoint.new(5/6,  Color3.fromRGB(255, 0,   255)),
                            ColorSequenceKeypoint.new(6/6,  Color3.fromRGB(255, 0,   0)),
                        }),
                    }, hueBar)

                    local hueThumb = New("Frame", {
                        Size             = UDim2.fromOffset(8, 12),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderSizePixel  = 0,
                        ZIndex           = 55,
                        AnchorPoint      = Vector2.new(0.5, 0),
                        Position         = UDim2.new(h, 0, 0, 0),
                    }, hueBar)
                    Corner(hueThumb, 4)

                    -- Hex input
                    local hexBg = New("Frame", {
                        Size             = UDim2.fromOffset(190, 26),
                        Position         = UDim2.fromOffset(15, 160),
                        BackgroundColor3 = Theme.Element,
                        BorderSizePixel  = 0,
                        ZIndex           = 51,
                    }, picker)
                    Corner(hexBg, 6)

                    local hexLabel = New("TextLabel", {
                        Size               = UDim2.fromOffset(20, 26),
                        BackgroundTransparency = 1,
                        Text               = "#",
                        TextColor3         = Theme.SubText,
                        TextSize           = 10,
                        Font               = Enum.Font.GothamBold,
                        ZIndex             = 52,
                    }, hexBg)

                    local hexInput = New("TextBox", {
                        Size               = UDim2.new(1, -24, 1, 0),
                        Position           = UDim2.fromOffset(20, 0),
                        BackgroundTransparency = 1,
                        Text               = color3ToHex(currentColor),
                        TextColor3         = Theme.Text,
                        TextSize           = 10,
                        Font               = Enum.Font.GothamMedium,
                        ClearTextOnFocus   = false,
                        ZIndex             = 52,
                    }, hexBg)

                    -- Apply button
                    local applyBtn = New("TextButton", {
                        Size               = UDim2.fromOffset(190, 24),
                        Position           = UDim2.fromOffset(15, 191),
                        BackgroundColor3   = Theme.Accent,
                        BorderSizePixel    = 0,
                        Text               = "Apply",
                        TextColor3         = Color3.new(1, 1, 1),
                        TextSize           = 10,
                        Font               = Enum.Font.GothamBold,
                        AutoButtonColor    = false,
                        ZIndex             = 51,
                    }, picker)
                    Corner(applyBtn, 6)

                    local function applyColor()
                        currentColor         = hsvToColor3(h, s, v)
                        preview.BackgroundColor3 = currentColor
                        preview.Text         = "#" .. color3ToHex(currentColor)
                        hexInput.Text        = color3ToHex(currentColor)
                        svBox.BackgroundColor3 = hsvToColor3(h, 1, 1)
                        if callback then callback(currentColor) end
                    end

                    -- SV dragging
                    local draggingSV = false
                    svBox.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = true
                            local px = math.clamp((inp.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
                            local py = math.clamp((inp.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
                            s = px; v = 1 - py
                            svThumb.Position = UDim2.new(s, 0, 1 - v, 0)
                            applyColor()
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(inp)
                        if draggingSV and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            local px = math.clamp((inp.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
                            local py = math.clamp((inp.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
                            s = px; v = 1 - py
                            svThumb.Position = UDim2.new(s, 0, 1 - v, 0)
                            applyColor()
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = false
                        end
                    end)

                    -- Hue dragging
                    local draggingHue = false
                    hueBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = true
                            h = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                            hueThumb.Position = UDim2.new(h, 0, 0, 0)
                            svBox.BackgroundColor3 = hsvToColor3(h, 1, 1)
                            applyColor()
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(inp)
                        if draggingHue and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            h = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                            hueThumb.Position = UDim2.new(h, 0, 0, 0)
                            svBox.BackgroundColor3 = hsvToColor3(h, 1, 1)
                            applyColor()
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = false
                        end
                    end)

                    -- Hex apply
                    hexInput.FocusLost:Connect(function()
                        local c = hexToColor3(hexInput.Text)
                        if c then
                            currentColor = c
                            h, s, v = Color3.toHSV(c)
                            svBox.BackgroundColor3 = hsvToColor3(h, 1, 1)
                            svThumb.Position = UDim2.new(s, 0, 1 - v, 0)
                            hueThumb.Position = UDim2.new(h, 0, 0, 0)
                            applyColor()
                        else
                            hexInput.Text = color3ToHex(currentColor)
                        end
                    end)

                    applyBtn.MouseButton1Click:Connect(function()
                        applyColor()
                        pickerOpen = false
                        picker:Destroy()
                        picker = nil
                    end)

                    applyBtn.MouseEnter:Connect(function() Tween(applyBtn, { BackgroundColor3 = Theme.AccentHover }) end)
                    applyBtn.MouseLeave:Connect(function() Tween(applyBtn, { BackgroundColor3 = Theme.Accent }) end)
                end

                preview.MouseButton1Click:Connect(function()
                    pickerOpen = not pickerOpen
                    if pickerOpen then
                        buildPicker()
                    else
                        if picker then picker:Destroy(); picker = nil end
                    end
                end)

                -- Config
                if cfgKey and configData[cfgKey] ~= nil then
                    local c = hexToColor3(configData[cfgKey])
                    if c then
                        currentColor = c
                        h, s, v      = Color3.toHSV(c)
                        preview.BackgroundColor3 = c
                        preview.Text = "#" .. color3ToHex(c)
                        if callback then callback(c) end
                    end
                end

                if cfgKey then
                    configCallbacks[cfgKey] = {
                        get     = function() return color3ToHex(currentColor) end,
                        set     = function(hex)
                            local c = hexToColor3(hex)
                            if c then
                                currentColor = c
                                h, s, v      = Color3.toHSV(c)
                                preview.BackgroundColor3 = c
                                preview.Text = "#" .. color3ToHex(c)
                                if callback then callback(c) end
                            end
                        end,
                        default = color3ToHex(default),
                    }
                end

                return {
                    Get = function() return currentColor end,
                    Set = function(c)
                        currentColor = c
                        h, s, v      = Color3.toHSV(c)
                        preview.BackgroundColor3 = c
                        preview.Text = "#" .. color3ToHex(c)
                        if callback then callback(c) end
                    end,
                }
            end

            return Section
        end

        return tabEntry
    end

    -- Auto-load config on startup
    if options.AutoLoad then
        task.defer(function()
            doLoad()
        end)
    end

    return windowAPI
end

return UI
