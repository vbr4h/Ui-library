                            ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
                            ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                        })
                    }, hueBar)

                    local hueThumb = New("Frame", {
                        Size = UDim2.fromOffset(8, 12),
                        AnchorPoint = Vector2.new(0.5, 0),
                        Position = UDim2.new(hue, 0, 0, 0),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderSizePixel = 0,
                        ZIndex = 55
                    }, hueBar)

                    Corner(hueThumb, 4)

                    local hexBackground = New("Frame", {
                        Size = UDim2.fromOffset(190, 26),
                        Position = UDim2.fromOffset(15, 160),
                        BackgroundColor3 = Theme.Element,
                        BorderSizePixel = 0,
                        ZIndex = 51
                    }, picker)

                    Corner(hexBackground, 6)

                    local hexInput = New("TextBox", {
                        Size = UDim2.new(1, -10, 1, 0),
                        Position = UDim2.fromOffset(5, 0),
                        BackgroundTransparency = 1,
                        Text = ColorToHex(current),
                        TextColor3 = Theme.Text,
                        TextSize = 9,
                        Font = Enum.Font.GothamMedium,
                        ClearTextOnFocus = false,
                        ZIndex = 52
                    }, hexBackground)

                    local function applyColor()
                        current = Color3.fromHSV(hue, saturation, value)

                        preview.BackgroundColor3 = current
                        preview.Text = "#" .. ColorToHex(current)

                        if callback then
                            callback(current)
                        end
                    end

                    sv.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                            local x = math.clamp(
                                (input.Position.X - sv.AbsolutePosition.X) /
                                sv.AbsoluteSize.X,
                                0,
                                1
                            )

                            local y = math.clamp(
                                (input.Position.Y - sv.AbsolutePosition.Y) /
                                sv.AbsoluteSize.Y,
                                0,
                                1
                            )

                            saturation = x
                            value = 1 - y

                            svThumb.Position = UDim2.new(
                                saturation,
                                0,
                                1 - value,
                                0
                            )

                            applyColor()
                        end
                    end)

                    hueBar.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                            hue = math.clamp(
                                (input.Position.X - hueBar.AbsolutePosition.X) /
                                hueBar.AbsoluteSize.X,
                                0,
                                1
                            )

                            hueThumb.Position = UDim2.new(
                                hue,
                                0,
                                0,
                                0
                            )

                            sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                            applyColor()
                        end
                    end)

                    hexInput.FocusLost:Connect(function()
                        local color = HexToColor(hexInput.Text)

                        if color then
                            current = color
                            hue, saturation, value = Color3.toHSV(color)
                            applyColor()

                            sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                            svThumb.Position = UDim2.new(
                                saturation,
                                0,
                                1 - value,
                                0
                            )

                            hueThumb.Position = UDim2.new(
                                hue,
                                0,
                                0,
                                0
                            )
                        else
                            hexInput.Text = ColorToHex(current)
                        end
                    end)

                    local apply = New("TextButton", {
                        Size = UDim2.fromOffset(190, 24),
                        Position = UDim2.fromOffset(15, 191),
                        BackgroundColor3 = Theme.Accent,
                        BorderSizePixel = 0,
                        Text = "Apply",
                        TextColor3 = Color3.new(1, 1, 1),
                        TextSize = 9,
                        Font = Enum.Font.GothamBold,
                        AutoButtonColor = false,
                        ZIndex = 51
                    }, picker)

                    Corner(apply, 6)

                    apply.MouseButton1Click:Connect(function()
                        applyColor()
                        destroyPicker()
                    end)
                end

                preview.MouseButton1Click:Connect(function()
                    if picker then
                        destroyPicker()
                    else
                        createPicker()
                    end
                end)

                local api = {
                    Get = function()
                        return current
                    end,
                    Set = function(color)
                        if typeof(color) ~= "Color3" then
                            return
                        end

                        current = color
                        hue, saturation, value = Color3.toHSV(color)
                        preview.BackgroundColor3 = color
                        preview.Text = "#" .. ColorToHex(color)

                        if callback then
                            callback(color)
                        end
                    end
                }

                if configId then
                    config:RegColorPicker(configId, api, default)
                end

                return api
            end

            return Section
        end

        return tab
    end

    local autoloadPath = config.Folder .. "__autoload.dat"
    local autoloadName = Filesystem.Read(autoloadPath)

    if autoloadName and autoloadName ~= "" then
        task.defer(function()
            config:LoadConfig(autoloadName:match("^%s*(.-)%s*$"))
        end)
    elseif options.AutoLoad then
        task.defer(function()
            config:LoadConfig(options.AutoLoad)
        end)
    elseif options.LoadConfig then
        task.defer(function()
            config:LoadConfig(options.LoadConfig)
        end)
    end

    return windowAPI
end

return UI
