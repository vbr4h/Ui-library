        BorderSizePixel = 0,
        Parent = Main,
    })

    newInstance("UICorner", {
        CornerRadius = UDim.new(0, 8),
        Parent = TabBar,
    })

    local TabLayout = newInstance("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
        Parent = TabBar,
    })

    newInstance("UIPadding", {
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        Parent = TabBar,
    })

    local Content = newInstance("Frame", {
        Size = UDim2.new(1, -20, 1, -(HEADER_H + TAB_H + 22)),
        Position = UDim2.new(0, 10, 0, HEADER_H + TAB_H + 14),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = Main,
    })

    do
        local dragging, dragStart, startPos = false, nil, nil

        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local minimized = false

    CloseBtn.MouseButton1Click:Connect(function()
        tween(Main, {
            Size = UDim2.new(0, WIN_W, 0, 0)
        }, 0.2)

        task.delay(0.22, function()
            ScreenGui:Destroy()
        end)
    end)

    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized

        if minimized then
            tween(Main, {
                Size = UDim2.new(0, WIN_W, 0, HEADER_H)
            }, 0.2)
        else
            tween(Main, {
                Size = UDim2.new(0, WIN_W, 0, WIN_H)
            }, 0.2)
        end
    end)

    for _, btn in ipairs({CloseBtn, MinBtn}) do
        btn.MouseEnter:Connect(function()
            tween(btn, {
                TextColor3 = theme.Text
            }, 0.12)
        end)

        btn.MouseLeave:Connect(function()
            tween(btn, {
                TextColor3 = theme.TextMuted
            }, 0.12)
        end)
    end

    local Window = {}
    local tabs = {}
    local activeTab = nil

    local function setActiveTab(tabObj)
        if activeTab == tabObj then
            return
        end

        if activeTab then
            tween(activeTab.Btn, {
                BackgroundColor3 = theme.Surface
            }, 0.15)

            tween(activeTab.Btn, {
                TextColor3 = theme.TextMuted
            }, 0.15)

            activeTab.Scroll.Visible = false
        end

        activeTab = tabObj

        tween(tabObj.Btn, {
            BackgroundColor3 = theme.Accent
        }, 0.15)

        tween(tabObj.Btn, {
            TextColor3 = theme.Text
        }, 0.15)

        tabObj.Scroll.Visible = true
    end

