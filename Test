    local notificationSlots = {}

    local function notify(text, notificationType, duration)
        notificationType = notificationType or "info"
        duration = duration or 3

        local slot = 1

        while notificationSlots[slot] do
            slot += 1
        end

        notificationSlots[slot] = true

        local colors = {
            info = Theme.Info,
            success = Theme.Success,
            warning = Theme.Warning,
            error = Theme.Error
        }

        local icons = {
            info = "i",
            success = "✓",
            warning = "!",
            error = "×"
        }

        local color = colors[notificationType] or Theme.Info

        local notification = New("Frame", {
            Size = UDim2.fromOffset(255, 56),
            Position = UDim2.new(1, 10, 1, -70 - (slot - 1) * 64),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            ZIndex = 100
        }, gui)

        Corner(notification, 8)
        Stroke(notification, color)

        local accent = New("Frame", {
            Size = UDim2.fromOffset(3, 36),
            Position = UDim2.fromOffset(7, 10),
            BackgroundColor3 = color,
            BorderSizePixel = 0
        }, notification)

        Corner(accent, 2)

        New("TextLabel", {
            Size = UDim2.fromOffset(20, 56),
            Position = UDim2.fromOffset(14, 0),
            BackgroundTransparency = 1,
            Text = icons[notificationType] or "•",
            TextColor3 = color,
            TextSize = 13,
            Font = Enum.Font.GothamBold
        }, notification)

        New("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0),
            Position = UDim2.fromOffset(36, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Theme.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true
        }, notification)

        Tween(notification, {
            Position = UDim2.new(
                1,
                -263,
                1,
                -70 - (slot - 1) * 64
            )
        })

        task.delay(duration, function()
            if notification.Parent then
                Tween(notification, {
                    Position = UDim2.new(
                        1,
                        10,
                        1,
                        -70 - (slot - 1) * 64
                    )
                })

                task.wait(0.22)

                if notification.Parent then
                    notification:Destroy()
                end
            end

            notificationSlots[slot] = nil
        end)

        return notification
    end

