    local function updateSize()
        camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport = camera.ViewportSize
        local width
        local height

        if IsMobile() then
            width = math.clamp(viewport.X - 24, 280, 500)
            height = math.clamp(viewport.Y - 60, 300, 440)
        else
            width = math.clamp(viewport.X * 0.60, 580, 800)
            height = math.clamp(viewport.Y * 0.64, 400, 520)
        end

        if viewport.X < 440 then
            width = viewport.X - 20
        end

        if viewport.Y < 520 then
            height = viewport.Y - 46
        end

        window.Size = UDim2.fromOffset(width, height)

        local sidebarWidth = math.clamp(width * 0.21, 120, 168)

        sidebar.Size = UDim2.new(0, sidebarWidth, 1, -76)
        sidebar.Position = UDim2.fromOffset(0, 46)

        content.Size = UDim2.new(1, -sidebarWidth - 10, 1, -86)
        content.Position = UDim2.fromOffset(sidebarWidth + 5, 50)

        configBar.Position = UDim2.new(0, 0, 1, -30)
        configBar.Size = UDim2.new(1, 0, 0, 30)
    end

    updateSize()

    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateSize)
    end

    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            dragPosition = window.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart

            window.Position = UDim2.new(
                dragPosition.X.Scale,
                dragPosition.X.Offset + delta.X,
                dragPosition.Y.Scale,
                dragPosition.Y.Offset + delta.Y
            )
        end
    end)

