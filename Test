        if typeof(changes) ~= "table" then
            return self
        end

        for key, value in pairs(changes) do
            self._theme[key] = value
        end

        self:_RefreshTheme()
        return self
    end

    function win:_RefreshTheme()
        local T = self._theme

        frame.BackgroundColor3 = T.Background
        topBar.BackgroundColor3 = T.Surface
        tabBar.BackgroundColor3 = T.Surface
        titleLabel.TextColor3 = T.Text
        subtitleLabel.TextColor3 = T.TextMuted
        topBarAccent.BackgroundColor3 = T.Accent
        shadow.ImageColor3 = Color3.new(0, 0, 0)
        tabScroll.ScrollBarImageColor3 = T.Accent

        for _, tab in pairs(self._tabsData) do
            if tab.button and tab.button.Parent then
                if tab == self._activeTab then
                    tab.button.BackgroundColor3 = T.Active
                    tab.icon.ImageColor3 = T.Accent
                    tab.label.TextColor3 = T.Text
                    tab.indicator.BackgroundColor3 = T.Accent
                else
                    tab.button.BackgroundColor3 = T.Surface
                    tab.icon.ImageColor3 = T.TextMuted
                    tab.label.TextColor3 = T.TextMuted
                    tab.indicator.BackgroundColor3 = T.Accent
                end
            end
        end

        for _, control in ipairs(self._controls) do
            if control and control._themeRefresh then
                pcall(control._themeRefresh)
            end
        end

        return self
    end

    function win:_RegisterControl(control)
        table.insert(self._controls, control)
        return control
    end

    function win:_SetConfig(key, value)
        if key ~= nil then
            self._configs[tostring(key)] = value
        end
    end

    function win:GetConfig(key, default)
        local value = self._configs[tostring(key)]
        if value == nil then
            return default
        end
        return value
    end

    function win:SetConfig(key, value)
        self:_SetConfig(key, value)

        for _, control in ipairs(self._controls) do
            if control._configKey == tostring(key) and control.Set then
                pcall(function()
                    control:Set(value)
                end)
            end
        end

        return self
    end

    function win:ResetConfig(key)
        if key == nil then
            for configKey, value in pairs(self._configs) do
                self._configs[configKey] = nil
            end

            for _, control in ipairs(self._controls) do
                if control._default ~= nil and control.Set then
                    pcall(function()
                        control:Set(control._default)
                    end)
                end
            end
        else
            self._configs[tostring(key)] = nil

            for _, control in ipairs(self._controls) do
                if control._configKey == tostring(key) and control.Set then
                    pcall(function()
                        control:Set(control._default)
                    end)
                end
            end
        end

        return self
    end

