        if self._destroyed then
            return self
        end

        self._destroyed = true

        Tween(root, {
            Size = UDim2.new(0.94, 0, 0.94, 0)
        }, 0.2)

        Tween(root, {
            Position = UDim2.new(0.5, -size.X.Offset * 0.47, 0.5, -size.Y.Offset * 0.47)
        }, 0.2)

        task.delay(0.21, function()
            if self._maid then
                self._maid:Clean()
            end

            for index, existing in ipairs(UI.Windows) do
                if existing == self then
                    table.remove(UI.Windows, index)
                    break
                end
            end
        end)

        return self
    end

    function win:Destroy()
        if self._destroyed then
