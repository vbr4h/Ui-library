            local function setFromPosition(position, fire)
                local absolutePosition = track.AbsolutePosition.X
                local absoluteSize = math.max(track.AbsoluteSize.X, 1)
                local percent = Clamp((position - absolutePosition) / absoluteSize, 0, 1)
                local nextValue = minimum + (maximum - minimum) * percent

                if math.abs(nextValue - math.floor(nextValue)) < 0.000001 then
                    nextValue = math.floor(nextValue)
                else
                    nextValue = math.floor(nextValue * 100 + 0.5) / 100
                end

                value = Clamp(nextValue, minimum, maximum)

                local normalized = maximum == minimum and 0 or (value - minimum) / (maximum - minimum)

                fill.Size = UDim2.new(normalized, 0, 1, 0)
                knob.Position = UDim2.new(normalized, 0, 0.5, 0)
                valueObject.Text = FormatNumber(value)

                if configKey then
                    self._window:_SetConfig(configKey, value)
                end

                if fire then
                    SafeCallback(callback, value)
                end
            end

            function control:Set(newValue)
                setFromPosition(
                    track.AbsolutePosition.X + (
                        Clamp(tonumber(newValue) or minimum, minimum, maximum) - minimum
                    ) / math.max(maximum - minimum, 0.000001) * track.AbsoluteSize.X,
                    true
                )

                return self
            end

            function control:Get()
                return value
            end

            function control:_themeRefresh()
                track.BackgroundColor3 = self._window._theme.Elevated
                fill.BackgroundColor3 = self._window._theme.Accent
                valueObject.TextColor3 = self._window._theme.Accent
            end

