            function Section:Slider(text, minimum, maximum, default, callback, configId)
                minimum = minimum or 0
                maximum = maximum or 100
                default = math.clamp(default or minimum, minimum, maximum)

                local value = default

                local item = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundTransparency = 1
                }, body)

                New("TextLabel", {
                    Size = UDim2.new(0.65, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 10,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, item)

                local valueLabel = New("TextLabel", {
                    Size = UDim2.new(0.35, 0, 0, 20),
                    Position = UDim2.new(0.65, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(value),
                    TextColor3 = Theme.SubText,
                    TextSize = 9,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Right
                }, item)

                local track = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 5),
                    Position = UDim2.fromOffset(0, 31),
                    BackgroundColor3 = Color3.fromRGB(30, 32, 42),
                    BorderSizePixel = 0
                }, item)

                Corner(track, 4)

                local fill = New("Frame", {
                    Size = UDim2.new(
                        (value - minimum) / (maximum - minimum),
                        0,
                        1,
                        0
                    ),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0
                }, track)

                Corner(fill, 4)

                local thumb = New("Frame", {
                    Size = UDim2.fromOffset(12, 12),
                    Position = UDim2.new(
                        (value - minimum) / (maximum - minimum),
                        -6,
                        0.5,
                        -6
                    ),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0
                }, track)

                Corner(thumb, 6)

                local draggingSlider = false

                local function set(valueToSet)
                    value = math.clamp(
                        tonumber(valueToSet) or minimum,
                        minimum,
                        maximum
                    )

                    local percent = (value - minimum) / (maximum - minimum)

                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    thumb.Position = UDim2.new(percent, -6, 0.5, -6)
                    valueLabel.Text = tostring(value)

                    if callback then
                        callback(value)
                    end
                end

                local function update(input)
                    local percent = math.clamp(
                        (input.Position.X - track.AbsolutePosition.X) /
                        track.AbsoluteSize.X,
                        0,
                        1
                    )

                    set(math.floor(
                        minimum + (maximum - minimum) * percent + 0.5
                    ))
                end

                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = true
                        update(input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if draggingSlider and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        update(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = false
                    end
                end)

                local api = {
                    Get = function()
                        return value
                    end,
                    Set = set
                }

                if configId then
                    config:RegSlider(configId, api, default)
                end

                return api
            end

