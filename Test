function UI:KeySystem(options, onSuccess, onFail)
    options = options or {}

    local validKeys = options.Keys or {}
    local title = options.Title or "Nebula Key System"
    local subtitle = options.Subtitle or "Enter your key to continue"
    local trialTime = options.TrialTime
    local discord = options.Discord
    local link = options.Link

    local storedKey = nil

    if readfile and isfile and isfile("NebulaUI/key.dat") then
        local ok, result = pcall(readfile, "NebulaUI/key.dat")

        if ok and result then
            storedKey = result:match("^%s*(.-)%s*$")
        end
    end

    if storedKey then
        for _, key in ipairs(validKeys) do
            if key == storedKey then
                if onSuccess then
                    onSuccess()
                end

                return
            end
        end
    end

    local player = Players.LocalPlayer
    local gui = New("ScreenGui", {
        Name = "NebulaKeySystem",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, player:WaitForChild("PlayerGui"))

    local backdrop = New("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0
    }, gui)

    local window = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(390, discord or link and 245 or 215),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    }, gui)

    Corner(window, 12)
    Stroke(window)

    New("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, window)

    New("TextLabel", {
        Size = UDim2.new(1, -30, 0, 34),
        Position = UDim2.fromOffset(15, 15),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, window)

    New("TextLabel", {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.fromOffset(15, 48),
        BackgroundTransparency = 1,
        Text = subtitle,
        TextColor3 = Theme.SubText,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, window)

    local inputBackground = New("Frame", {
        Size = UDim2.new(1, -30, 0, 38),
        Position = UDim2.fromOffset(15, 78),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0
    }, window)

    Corner(inputBackground, 7)
    Stroke(inputBackground)

    local input = New("TextBox", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Enter key...",
        PlaceholderColor3 = Theme.SubText,
        TextColor3 = Theme.Text,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        ClearTextOnFocus = false
    }, inputBackground)

    local status = New("TextLabel", {
        Size = UDim2.new(1, -30, 0, 18),
        Position = UDim2.fromOffset(15, 120),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Theme.SubText,
        TextSize = 9,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, window)

    local submit = New("TextButton", {
        Size = UDim2.new(0, 200, 0, 34),
        Position = UDim2.fromOffset(15, 145),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Text = "Submit Key",
        TextColor3 = Theme.Text,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, window)

    Corner(submit, 7)

    local trial

    if trialTime then
        trial = New("TextButton", {
            Size = UDim2.new(0, 125, 0, 34),
            Position = UDim2.fromOffset(230, 145),
            BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0,
            Text = "Trial",
            TextColor3 = Theme.Text,
            TextSize = 10,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false
        }, window)

        Corner(trial, 7)
    end

    if discord or link then
        New("TextLabel", {
            Size = UDim2.new(1, -30, 0, 18),
            Position = UDim2.fromOffset(15, 190),
            BackgroundTransparency = 1,
            Text = (discord and "Discord: " .. discord or "") .. (discord and link and "  |  " or "") .. (link or ""),
            TextColor3 = Theme.SubText,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left
        }, window)
    end

    local function checkKey(value)
        value = value:match("^%s*(.-)%s*$")

        for _, key in ipairs(validKeys) do
            if key == value then
                return true
            end
        end

        return false
    end

    submit.MouseButton1Click:Connect(function()
        if checkKey(input.Text) then
            Filesystem.MakeFolder("NebulaUI")
            Filesystem.Write("NebulaUI/key.dat", input.Text)

            status.Text = "Key accepted."
            status.TextColor3 = Theme.Success

            task.wait(0.5)
            gui:Destroy()

            if onSuccess then
                onSuccess()
            end
        else
            status.Text = "Invalid key."
            status.TextColor3 = Theme.Error
        end
    end)

    if trial then
        trial.MouseButton1Click:Connect(function()
            gui:Destroy()

            if onSuccess then
                onSuccess()
            end

            if trialTime then
                task.delay(trialTime, function()
                    if onFail then
                        onFail("trial_expired")
                    end
                end)
            end
        end)
    end

    submit.MouseEnter:Connect(function()
        Tween(submit, {
            BackgroundColor3 = Theme.AccentHover
        })
    end)

    submit.MouseLeave:Connect(function()
        Tween(submit, {
            BackgroundColor3 = Theme.Accent
        })
    end)
end

