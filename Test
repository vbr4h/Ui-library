            control._default = currentColor

            local function updateColor(fire)
                currentColor = Color3.fromHSV(hue, saturationValue, valueValue)
                colorButton.BackgroundColor3 = currentColor

                hueKnob.Position = UDim2.new(hue, 0, 0.5, 0)
                pickerKnob.Position = UDim2.new(saturationValue, 0, 1 - valueValue, 0)

                if configKey then
                    self._window:_SetConfig(configKey, currentColor)
                end

                if fire then
                    SafeCallback(callback, currentColor)
                end
            end

            local function updateHue(position)
                local x = Clamp(
                    (position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1),
                    0,
                    1
                )

                hue = x
                updateColor(true)
            end

            local function updateSV(position)
                local x = Clamp(
                    (position.X - saturation.AbsolutePosition.X) / math.max(saturation.AbsoluteSize.X, 1),
                    0,
                    1
                )

                local y = Clamp(
                    (position.Y - saturation.AbsolutePosition.Y) / math.max(saturation.AbsoluteSize.Y, 1),
                    0,
                    1
                )

                saturationValue = x
                valueValue = 1 - y
                updateColor(true)
            end

            local hueDragging = false
            local svDragging = false

            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = true
                    updateHue(input.Position)
                end
            end)

            saturation.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDragging = true
                    updateSV(input.Position)
                end
            end)

            self._window._maid:Add(Services.UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if hueDragging then
                        updateHue(input.Position)
                    elseif svDragging then
                        updateSV(input.Position)
                    end
                end
            end))

            self._window._maid:Add(Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = false
                    svDragging = false
                end
            end))

            colorButton.Activated:Connect(function()
                opened = not opened

                if opened then
                    picker.Visible = true

                    Tween(picker, {
                        Size = UDim2.new(1, 0, 0, 140)
                    }, 0.2, Enum.EasingStyle.Quart)
                else
                    Tween(picker, {
                        Size = UDim2.new(1, 0, 0, 0)
                    }, 0.16)

                    task.delay(0.17, function()
                        if picker.Parent and not opened then
                            picker.Visible = false
                        end
                    end)
                end
            end)

            function control:Set(value)
                if typeof(value) == "Color3" then
                    currentColor = value
                    hue, saturationValue, valueValue = value:ToHSV()
                    updateColor(true)
                end

                return self
            end

            function control:Get()
                return currentColor
            end

            function control:_themeRefresh()
                picker.BackgroundColor3 = self._window._theme.Elevated
            end

            self:_AddControl(control)
            updateColor(false)

            return self
        end

        function tabObject:Armor(options)
            options = typeof(options) == "table" and options or {}

            local armorEnabled = options.Enabled == true
            local armorValue = tonumber(options.Value) or 100
            local maximumArmor = tonumber(options.Maximum) or tonumber(options.MaxArmor) or 100
            local regenerationEnabled = options.Regeneration == true
            local regenerationAmount = tonumber(options.RegenerationAmount) or 1
            local regenerationDelay = tonumber(options.RegenerationDelay) or 1

            maximumArmor = math.max(0, maximumArmor)
            armorValue = Clamp(armorValue, 0, maximumArmor)

            self:Section(options.SectionName or "Armor")

            self:Toggle(
                options.EnabledName or "Armor Enabled",
                armorEnabled,
                options.OnEnabledChanged,
                options.EnabledConfig
            )

            self:Slider(
                options.ValueName or "Armor Value",
                armorValue,
                0,
                maximumArmor,
                options.OnValueChanged,
                options.ValueConfig
            )

            self:Slider(
                options.MaximumName or "Maximum Armor",
                maximumArmor,
                0,
                math.max(maximumArmor, tonumber(options.MaximumLimit) or 500),
                options.OnMaximumChanged,
                options.MaximumConfig
            )

            self:Toggle(
                options.RegenerationName or "Regeneration",
                regenerationEnabled,
                options.OnRegenerationChanged,
                options.RegenerationConfig
            )

            self:Slider(
                options.RegenerationAmountName or "Regeneration Amount",
                regenerationAmount,
                0,
                tonumber(options.RegenerationAmountMaximum) or 100,
                options.OnRegenerationAmountChanged,
                options.RegenerationAmountConfig
            )

            self:Slider(
                options.RegenerationDelayName or "Regeneration Delay",
                regenerationDelay,
                0,
                tonumber(options.RegenerationDelayMaximum) or 30,
                options.OnRegenerationDelayChanged,
                options.RegenerationDelayConfig
            )

            self:Button(options.ResetName or "Reset Armor", function()
                armorValue = maximumArmor

                if typeof(options.OnReset) == "function" then
                    SafeCallback(options.OnReset, armorValue, maximumArmor)
                end
            end)

            self:Paragraph(
                options.StatusTitle or "Armor Status",
                options.StatusText or "Armor values are configuration-only and can be connected to your own game systems."
            )

            return self
        end

        function tabObject:Search(query)
            query = tostring(query or ""):lower()

            for _, control in ipairs(self._controls) do
                if control:IsA("Frame") then
                    local matches = query == ""

                    if not matches then
                        for _, descendant in ipairs(control:GetDescendants()) do
                            if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                                if tostring(descendant.Text):lower():find(query, 1, true) then
                                    matches = true
                                    break
                                end
                            end
                        end
                    end

                    control.Visible = matches
                end
            end

            return self
        end

        tabButton.MouseEnter:Connect(function()
            if self._activeTab ~= tabData then
                Tween(tabButton, {
                    BackgroundColor3 = self._theme.Hover
                }, 0.1)

                Tween(tabIconObject, {
                    ImageColor3 = self._theme.Text
                }, 0.1)

                Tween(label, {
                    TextColor3 = self._theme.Text
                }, 0.1)
            end
        end)

        tabButton.MouseLeave:Connect(function()
            if self._activeTab ~= tabData then
                Tween(tabButton, {
                    BackgroundColor3 = self._theme.Surface
                }, 0.1)

                Tween(tabIconObject, {
                    ImageColor3 = self._theme.TextMuted
                }, 0.1)

                Tween(label, {
                    TextColor3 = self._theme.TextMuted
                }, 0.1)
            end
        end)

        tabButton.Activated:Connect(function()
            self:SelectTab(tabName)
        end)

        if not self._activeTab then
            self:SelectTab(tabName, true)
        end

        return tabObject
    end

    function win:SelectTab(tabName, instant)
        local tab = self._tabsData[tostring(tabName)]

        if not tab then
            return self
        end

        if self._activeTab == tab then
            return self
        end

        local previous = self._activeTab
        self._activeTab = tab

        if previous then
            previous.page.Visible = false

            Tween(previous.button, {
                BackgroundColor3 = self._theme.Surface
            }, 0.13)

            Tween(previous.icon, {
                ImageColor3 = self._theme.TextMuted
            }, 0.13)

            Tween(previous.label, {
                TextColor3 = self._theme.TextMuted
            }, 0.13)

            Tween(previous.indicator, {
                BackgroundTransparency = 1
            }, 0.13)
        end

        tab.page.Visible = true
        tab.page.Position = UDim2.new(0, instant and 0 or 8, 0, 0)

        Tween(tab.button, {
            BackgroundColor3 = self._theme.Active
        }, instant and 0 or 0.16)

        Tween(tab.icon, {
            ImageColor3 = self._theme.Accent
        }, instant and 0 or 0.16)

        Tween(tab.label, {
            TextColor3 = self._theme.Text
        }, instant and 0 or 0.16)

        Tween(tab.indicator, {
            BackgroundTransparency = 0
        }, instant and 0 or 0.16)

        if not instant then
            Tween(tab.page, {
                Position = UDim2.new(0, 0, 0, 0)
            }, 0.18, Enum.EasingStyle.Quart)
        end

        return self
    end

    function win:GetActiveTab()
        return self._activeTab and self._activeTab.name or nil
    end

    function win:GetTabs()
        local result = {}

        for name in pairs(self._tabsData) do
            table.insert(result, name)
        end

        return result
    end

    function win:BindKeybind(keyCode, callback)
        if typeof(keyCode) ~= "EnumItem" then
            return self
        end

        local connection = Services.UserInputService.InputBegan:Connect(function(input, processed)
            if processed then
                return
            end

            if input.KeyCode == keyCode then
                SafeCallback(callback)
            end
        end)

        self._maid:Add(connection)

        return self
    end

    function win:SetToggleKey(keyCode)
        if typeof(keyCode) ~= "EnumItem" then
            return self
        end

        if self._toggleConnection then
            self._toggleConnection:Disconnect()
        end

        self._toggleConnection = Services.UserInputService.InputBegan:Connect(function(input, processed)
            if processed then
                return
            end

            if input.KeyCode == keyCode then
                self._screenGui.Enabled = not self._screenGui.Enabled
            end
        end)

        self._maid:Add(self._toggleConnection)

        return self
    end

    function win:SetTitle(value)
        titleLabel.Text = tostring(value or "")
        return self
    end

    function win:SetSubtitle(value)
        subtitleLabel.Text = tostring(value or "")
        subtitleLabel.Visible = tostring(value or "") ~= ""
        return self
    end

    function win:SetIcon(value)
        local image = GetIcon(value)

        if not iconFrame and image then
            iconFrame = Base("ImageLabel", {
                Size = UDim2.new(0, 38, 0, 38),
                Position = UDim2.new(0, 16, 0.5, -19),
                BackgroundColor3 = self._theme.Elevated,
                BackgroundTransparency = 0.15,
                Image = image,
                ImageColor3 = self._theme.Text,
                ScaleType = Enum.ScaleType.Fit,
                BorderSizePixel = 0,
                ZIndex = 5,
                Parent = topBar
            })

            Corner(iconFrame, 9)
        elseif iconFrame then
            iconFrame.Image = image or ""
        end

        return self
    end

    function win:SetSize(newSize)
        if typeof(newSize) ~= "UDim2" then
            return self
        end

        size = newSize
        self._size = newSize

        Tween(root, {
            Size = newSize,
            Position = UDim2.new(
                0.5,
                -newSize.X.Offset / 2,
                0.5,
                -newSize.Y.Offset / 2
            )
        }, 0.2)

        return self
    end

    function win:Center()
        Tween(root, {
            Position = UDim2.new(
                0.5,
                -root.AbsoluteSize.X / 2,
                0.5,
                -root.AbsoluteSize.Y / 2
            )
        }, 0.2)

        return self
    end

    function win:_ClampToViewport()
        if not root.Parent then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local viewport = camera.ViewportSize
        local absoluteSize = root.AbsoluteSize
        local position = root.AbsolutePosition

        local maxX = math.max(0, viewport.X - absoluteSize.X)
        local maxY = math.max(0, viewport.Y - absoluteSize.Y)

        local x = Clamp(position.X, 0, maxX)
        local y = Clamp(position.Y, 0, maxY)

        if math.abs(x - position.X) > 1 or math.abs(y - position.Y) > 1 then
            root.Position = UDim2.fromOffset(x, y)
        end
    end

    if resizeHandle then
        local resizing = false
        local resizeStart
        local resizeSize

        resizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                resizeStart = input.Position
                resizeSize = root.AbsoluteSize
            end
        end)

        self._maid:Add(Services.UserInputService.InputChanged:Connect(function(input)
            if not resizing then
                return
            end

            if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local delta = input.Position - resizeStart

            local width = math.max(self._minimumSize.X, resizeSize.X + delta.X)
            local height = math.max(self._minimumSize.Y, resizeSize.Y + delta.Y)

            root.Size = UDim2.fromOffset(width, height)
        end))

        self._maid:Add(Services.UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end))
    end

    MakeDraggable(root, topBar, maid)

    minimizeButton.Activated:Connect(function()
        if self._minimized then
            self:Restore()
        else
            self:Minimize()
        end
    end)

    closeButton.Activated:Connect(function()
        self:Close()
    end)

    local viewportConnection = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local camera = workspace.CurrentCamera

        if camera then
            self._maid:Add(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                self:_ClampToViewport()
            end))
        end
    end)

    maid:Add(viewportConnection)

    if workspace.CurrentCamera then
        maid:Add(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            self:_ClampToViewport()
        end))
    end

    if options.ToggleKey then
        self:SetToggleKey(options.ToggleKey)
    end

    if options.StartupSound and options.StartupSound.Toggle then
        local soundConfig = options.StartupSound

        local sound = Base("Sound", {
            Name = "StartupSound",
            SoundId = tostring(soundConfig.SoundID or "rbxassetid://6958727243"),
            Volume = tonumber(soundConfig.Volume) or 0.5,
            TimePosition = tonumber(soundConfig.TimePosition) or 0,
            Parent = screenGui
        })

        maid:Add(sound)

        task.defer(function()
            pcall(function()
                sound:Play()
            end)
        end)
    end

    local startupAnimation = options.StartupAnimation ~= false

    if startupAnimation then
        root.Size = UDim2.new(0, size.X.Offset * 0.92, 0, size.Y.Offset * 0.92)
        root.Position = UDim2.new(0.5, -size.X.Offset * 0.46, 0.5, -size.Y.Offset * 0.46)

        Tween(root, {
            Size = size,
            Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2)
        }, 0.3, Enum.EasingStyle.Back)
    end

    task.defer(function()
        self:_ClampToViewport()
    end)

    if options.AutoNotify then
        self:Notify({
            Type = "Success",
            Title = title,
            Message = tostring(options.AutoNotifyMessage or "Interface initialized."),
            Duration = 3
        })
    end

    return win
end

function UI.Window(title, size)
    return UI.Create({
        Name = title,
        Size = size
    })
end

function UI.GetWindow(name)
    if name == nil then
        return UI.Windows[1]
    end

    for _, window in ipairs(UI.Windows) do
        if window._title == name then
            return window
        end
    end

    return nil
end

function UI.DestroyAll()
    for index = #UI.Windows, 1, -1 do
        local window = UI.Windows[index]

        if window and window.Destroy then
            pcall(function()
                window:Destroy()
            end)
        end

        UI.Windows[index] = nil
    end
end

return UI
