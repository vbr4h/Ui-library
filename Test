function ConfigSystem:RegKeybind(id, api, default)
    return self:RegisterControl(
        id,
        "keybind",
        function()
            local key = api:Get()
            return key and key.Name or "Unknown"
        end,
        function(value)
            local key = Enum.KeyCode[value]

            if key then
                api:Set(key)
            end
        end,
        default and default.Name or "Unknown"
    )
end

function ConfigSystem:RegColorPicker(id, api, default)
    return self:RegisterControl(
        id,
        "colorpicker",
        function()
            return ColorToHex(api:Get())
        end,
        function(value)
            local color = HexToColor(value)

            if color then
                api:Set(color)
            end
        end,
        default and ColorToHex(default) or "EE2340"
    )
end

