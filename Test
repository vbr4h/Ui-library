local UI = {}
UI.__index = UI

function UI:CreateWindow(title)
    local player = game:GetService("Players").LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name = "UILibrary"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local main = Instance.new("Frame")
    main.Size = UDim2.fromOffset(500, 320)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    main.BorderSizePixel = 0
    main.Parent = gui

    local corner = Instance.new("UICorner", main)
    corner.CornerRadius = UDim.new(0, 10)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 45)
    titleLabel.Position = UDim2.fromOffset(15, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title or "UI Library"
    titleLabel.TextColor3 = Color3.new(1, 1, 1)
    titleLabel.TextSize = 18
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = main

    local tabs = Instance.new("Frame")
    tabs.Size = UDim2.fromOffset(120, 260)
    tabs.Position = UDim2.fromOffset(10, 50)
    tabs.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
    tabs.BorderSizePixel = 0
    tabs.Parent = main

    Instance.new("UICorner", tabs).CornerRadius = UDim.new(0, 8)

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -145, 1, -60)
    content.Position = UDim2.fromOffset(140, 50)
    content.BackgroundTransparency = 1
    content.Parent = main

    local tabList = Instance.new("UIListLayout", tabs)
    tabList.Padding = UDim.new(0, 5)
    tabList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local window = {
        Main = main,
        Tabs = tabs,
        Content = content,
        Pages = {}
    }

    function window:Tab(name)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -10, 0, 38)
        button.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        button.Text = name
        button.TextColor3 = Color3.fromRGB(210, 210, 215)
        button.TextSize = 14
        button.Font = Enum.Font.GothamMedium
        button.BorderSizePixel = 0
        button.Parent = tabs

        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.Visible = #self.Pages == 0
        page.Parent = content

        local layout = Instance.new("UIListLayout", page)
        layout.Padding = UDim.new(0, 8)

        local tab = {
            Button = button,
            Page = page
        }

        button.MouseButton1Click:Connect(function()
            for _, other in pairs(self.Pages) do
                other.Page.Visible = false
            end
            page.Visible = true
        end)

        table.insert(self.Pages, tab)
        return tab
    end

    return window
end

return UI
