--  KEY SYSTEM
-- ─────────────────────────────────────────────────────────────────────────────
function UI:KeySystem(options, onSuccess, onFail)
    options = options or {}
    local validKeys  = options.Keys     or {}
    local title      = options.Title    or "Nebula Key System"
    local subtitle   = options.Subtitle or "Enter your key to continue"
    local trialTime  = options.TrialTime  -- seconds; nil = no trial
    local discord    = options.Discord  or nil
    local link       = options.Link     or nil

    -- Key stored persistently
    local storedKey = nil
    if readfile and isfile and isfile("NebulaUI/key.dat") then
        storedKey = readfile("NebulaUI/key.dat"):match("^%s*(.-)%s*$")
    end

    if storedKey then
        for _, k in ipairs(validKeys) do
            if k == storedKey then
                if onSuccess then onSuccess() end
                return
            end
        end
    end

    -- Build Key UI
    local player = Players.LocalPlayer
    local gui = New("ScreenGui", {
        Name            = "NebulaKeySystem",
        ResetOnSpawn    = false,
        IgnoreGuiInset  = true,
        ZIndexBehavior  = Enum.ZIndexBehavior.Sibling,
    }, player:WaitForChild("PlayerGui"))

    -- Blur
    local blur = New("Frame", {
        Size                = UDim2.fromScale(1, 1),
        BackgroundColor3    = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.55,
        BorderSizePixel     = 0,
        ZIndex              = 1,
    }, gui)

    local win = New("Frame", {
        AnchorPoint         = Vector2.new(0.5, 0.5),
        Position            = UDim2.fromScale(0.5, 0.5),
        Size                = UDim2.fromOffset(380, 220),
        BackgroundColor3    = Theme.Background,
        BorderSizePixel     = 0,
        ZIndex              = 2,
    }, gui)
    Corner(win, 12)
    Stroke(win)

    -- Top accent strip
    New("Frame", {
        Size             = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 3,
    }, win)
    Corner(win, 12)

    New("TextLabel", {
        Size                = UDim2.new(1, 0, 0, 36),
        Position            = UDim2.fromOffset(0, 3),
        BackgroundTransparency = 1,
        Text                = title,
        TextColor3          = Theme.Text,
        TextSize            = 15,
        Font                = Enum.Font.GothamBold,
        ZIndex              = 3,
    }, win)

    New("TextLabel", {
        Size                = UDim2.new(1, 0, 0, 20),
        Position            = UDim2.fromOffset(0, 36),
        BackgroundTransparency = 1,
        Text                = subtitle,
        TextColor3          = Theme.SubText,
        TextSize            = 10,
        Font                = Enum.Font.GothamMedium,
        ZIndex              = 3,
    }, win)

    -- Input box
    local inputBg = New("Frame", {
        Size             = UDim2.new(1, -40, 0, 36),
        Position         = UDim2.new(0, 20, 0, 70),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel  = 0,
        ZIndex           = 3,
    }, win)
    Corner(inputBg, 8)
    Stroke(inputBg)

    local input = New("TextBox", {
        Size                = UDim2.new(1, -16, 1, 0),
        Position            = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text                = "",
        PlaceholderText     = "Paste your key here...",
        PlaceholderColor3   = Theme.SubText,
        TextColor3          = Theme.Text,
        TextSize            = 11,
        Font                = Enum.Font.GothamMedium,
        ClearTextOnFocus    = false,
        ZIndex              = 4,
    }, inputBg)

    -- Status label
    local status = New("TextLabel", {
        Size                = UDim2.new(1, -40, 0, 18),
        Position            = UDim2.new(0, 20, 0, 113),
        BackgroundTransparency = 1,
        Text                = "",
        TextColor3          = Theme.SubText,
        TextSize            = 9,
        Font                = Enum.Font.GothamMedium,
        TextXAlignment      = Enum.TextXAlignment.Left,
        ZIndex              = 3,
    }, win)

    -- Buttons row
    local function makeBtn(text, color, xPos, w)
        local btn = New("TextButton", {
            Size             = UDim2.new(0, w, 0, 34),
            Position         = UDim2.new(0, xPos, 0, 138),
            BackgroundColor3 = color,
            BorderSizePixel  = 0,
            Text             = text,
            TextColor3       = Theme.Text,
            TextSize         = 11,
            Font             = Enum.Font.GothamBold,
            AutoButtonColor  = false,
            ZIndex           = 3,
        }, win)
        Corner(btn, 8)
        return btn
    end

    local submitBtn = makeBtn("Submit Key", Theme.Accent, 20, 200)
    local trialBtn  = trialTime and makeBtn("Trial (" .. trialTime .. "s)", Theme.Element, 230, 130) or nil

    -- Link row
    if discord or link then
        local linkText = (discord and "Discord: " .. discord or "") ..
                         (discord and link and "  ·  " or "") ..
                         (link and link or "")
        New("TextLabel", {
            Size                = UDim2.new(1, -40, 0, 18),
            Position            = UDim2.new(0, 20, 0, 195),
            BackgroundTransparency = 1,
            Text                = linkText,
            TextColor3          = Theme.SubText,
            TextSize            = 9,
            Font                = Enum.Font.GothamMedium,
            TextXAlignment      = Enum.TextXAlignment.Left,
            ZIndex              = 3,
        }, win)
        win.Size = UDim2.fromOffset(380, 225)
    end

    local function checkKey(key)
        key = key:match("^%s*(.-)%s*$")
        for _, k in ipairs(validKeys) do
            if k == key then return true end
        end
        return false
    end

    submitBtn.MouseButton1Click:Connect(function()
        local key = input.Text
        if checkKey(key) then
            -- Save key
            if writefile and makefolder then
                if not isfolder("NebulaUI/") then makefolder("NebulaUI/") end
                writefile("NebulaUI/key.dat", key)
            end
            status.Text      = "✓  Key accepted! Loading..."
            status.TextColor3 = Theme.Success
            task.wait(0.8)
            gui:Destroy()
            if onSuccess then onSuccess() end
        else
            status.Text       = "✗  Invalid key. Please try again."
            status.TextColor3 = Theme.Error
            Tween(inputBg, { BackgroundColor3 = Color3.fromRGB(60, 20, 28) })
            task.delay(0.5, function()
                Tween(inputBg, { BackgroundColor3 = Theme.Element })
            end)
        end
    end)

    if trialBtn then
        local trialActive = false
        trialBtn.MouseButton1Click:Connect(function()
            if trialActive then return end
            trialActive = true
            status.Text       = "⏱  Trial started — " .. trialTime .. "s remaining"
            status.TextColor3 = Theme.Warning
            gui:Destroy()
            if onSuccess then onSuccess() end
            task.delay(trialTime, function()
                if onFail then onFail("trial_expired") end
            end)
        end)
    end

    -- hover effects
    submitBtn.MouseEnter:Connect(function() Tween(submitBtn, { BackgroundColor3 = Theme.AccentHover }) end)
    submitBtn.MouseLeave:Connect(function() Tween(submitBtn, { BackgroundColor3 = Theme.Accent }) end)
end

