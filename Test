    local connRgb = RunService.RenderStepped:Connect(function()
        local hue = (os.clock() * 0.2) % 1
        uiGradient.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1), Color3.fromHSV((hue + 0.3) % 1, 1, 1))
    end)
    table.insert(self.Connections, connRgb)
    
    self.ToggleFloatBtn = Instance.new("TextButton")
    self.ToggleFloatBtn.Size = UDim2.new(0, 40, 0, 40)
    self.ToggleFloatBtn.Position = UDim2.new(0, 30, 0.5, -20)
    self.ToggleFloatBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
    self.ToggleFloatBtn.Text = "UI"
    self.ToggleFloatBtn.TextColor3 = Color3.fromRGB(225, 25, 50)
    self.ToggleFloatBtn.TextSize = 12
    self.ToggleFloatBtn.Font = Enum.Font.GothamBold
    self.ToggleFloatBtn.Visible = false
    self.ToggleFloatBtn.Parent = self.ScreenGui
    
    local floatCorner = Instance.new("UICorner")
    floatCorner.CornerRadius = UDim.new(1, 0)
    floatCorner.Parent = self.ToggleFloatBtn
    
    local floatStroke = Instance.new("UIStroke")
    floatStroke.Color = Color3.fromRGB(225, 25, 50)
    floatStroke.Thickness = 1.5
    floatStroke.Parent = self.ToggleFloatBtn
    
    local floatDragging, floatDragStart, floatStartPos
    self.ToggleFloatBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            floatDragging = true
            floatDragStart = input.Position
            floatStartPos = self.ToggleFloatBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    floatDragging = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if floatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - floatDragStart
            self.ToggleFloatBtn.Position = UDim2.new(floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X, floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y)
        end
    end)

    function self.ToggleUI(isOpen)
        self.Opened = isOpen
        if isOpen then
            self.ToggleFloatBtn.Visible = false
            self.MainFrame.Visible = true
            self.MainFrame.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(self.MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 520, 0, 340)
            }):Play()
        else
            local tw = TweenService:Create(self.MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0)
            })
            tw:Play()
            tw.Completed:Connect(function()
                if not self.Opened then
                    self.MainFrame.Visible = false
                    self.ToggleFloatBtn.Visible = true
                end
            end)
        end
    end

    self.ToggleFloatBtn.MouseButton1Click:Connect(function()
        if not self.Opened then
            self.ToggleUI(true)
        end
    end)
    
    self.CloseBtn = Instance.new("TextButton")
    self.CloseBtn.Size = UDim2.new(0, 26, 1, 0)
    self.CloseBtn.Position = UDim2.new(1, -26, 0, 0)
    self.CloseBtn.BackgroundTransparency = 1
    self.CloseBtn.Text = "×"
    self.CloseBtn.TextColor3 = Color3.fromRGB(160, 160, 170)
    self.CloseBtn.TextSize = 14
    self.CloseBtn.Font = Enum.Font.Gotham
    self.CloseBtn.Parent = self.TopBar
    
    local cConn = self.CloseBtn.MouseButton1Click:Connect(function()
        self.ToggleUI(false)
    end)
    table.insert(self.Connections, cConn)
    
    self.MinBtn = Instance.new("TextButton")
    self.MinBtn.Size = UDim2.new(0, 26, 1, 0)
    self.MinBtn.Position = UDim2.new(1, -52, 0, 0)
    self.MinBtn.BackgroundTransparency = 1
    self.MinBtn.Text = "—"
    self.MinBtn.TextColor3 = Color3.fromRGB(160, 160, 170)
    self.MinBtn.TextSize = 10
    self.MinBtn.Font = Enum.Font.Gotham
    self.MinBtn.Parent = self.TopBar
    
    local mConn = self.MinBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        self.Sidebar.Visible = not self.Minimized
        if self.ActiveTab then
            self.ActiveTab.Container.Visible = not self.Minimized
        end
        self.MainFrame.Size = self.Minimized and UDim2.new(0, 520, 0, 26) or UDim2.new(0, 520, 0, 340)
    end)
    table.insert(self.Connections, mConn)
    
    self.Sidebar = Instance.new("ScrollingFrame")
    self.Sidebar.Size = UDim2.new(0, 130, 1, -28)
    self.Sidebar.Position = UDim2.new(0, 0, 0, 28)
    self.Sidebar.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    self.Sidebar.BorderSizePixel = 0
    self.Sidebar.ScrollBarThickness = 2
    self.Sidebar.ScrollBarImageColor3 = Color3.fromRGB(40, 40, 48)
    self.Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.Sidebar.Parent = self.MainFrame
    
    local sideList = Instance.new("UIListLayout")
    sideList.SortOrder = Enum.SortOrder.LayoutOrder
    sideList.Padding = UDim.new(0, 2)
    sideList.Parent = self.Sidebar
    
    sideList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        self.Sidebar.CanvasSize = UDim2.new(0, 0, 0, sideList.AbsoluteContentSize.Y + 4)
    end)
    
    self.ContentArea = Instance.new("Frame")
    self.ContentArea.Size = UDim2.new(1, -130, 1, -28)
    self.ContentArea.Position = UDim2.new(0, 130, 0, 28)
    self.ContentArea.BackgroundTransparency = 1
    self.ContentArea.Parent = self.MainFrame
    
    self.Tabs = {}
    self.ActiveTab = nil
    
    local dragging, dragStart, startPos
    local conn1 = self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    table.insert(self.Connections, conn1)
    
    local conn2 = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y
            if self.ConstrainToScreen then
                local viewport = workspace.CurrentCamera.ViewportSize
                newX = math.clamp(newX, 0, viewport.X - self.MainFrame.AbsoluteSize.X)
                newY = math.clamp(newY, 0, viewport.Y - self.MainFrame.AbsoluteSize.Y)
            end
            self.MainFrame.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
        end
    end)
    table.insert(self.Connections, conn2)
    
    function self.Cleanup()
        for _, connection in ipairs(self.Connections) do
            if connection.Connected then
                connection:Disconnect()
            end
        end
        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end
        getgenv().VbraUIInstance = nil
    end

    getgenv().VbraUIInstance = self
    return self
end

function Library:LockScreenBoundaries(state)
    self.ConstrainToScreen = state
end

