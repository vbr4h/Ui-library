    -- ── Layout / sizing ───────────────────────────────────────────────────────
    local pages      = {}
    local minimized  = false
    local savedHeight = 0
    local dragging   = false
    local dragStart, dragPos

    local function updateSize()
        camera = workspace.CurrentCamera
        if not camera then return end

        local vp     = camera.ViewportSize
        local mobile = isMobile()
        local w, h

        if mobile then
            w = math.clamp(vp.X - 24, 280, 500)
            h = math.clamp(vp.Y - 60, 300, 440)
        else
            w = math.clamp(vp.X * 0.60, 580, 800)
            h = math.clamp(vp.Y * 0.64, 400, 520)
        end

        if vp.X < 440 then w = vp.X - 20 end
        if vp.Y < 520 then h = vp.Y - 46 end

        window.Size = UDim2.fromOffset(w, h)
        savedHeight = h

        local sw = math.clamp(w * 0.21, 120, 168)
        sidebar.Size     = UDim2.new(0, sw, 1, -74)
        sidebar.Position = UDim2.fromOffset(0, 46)

        content.Size     = UDim2.new(1, -sw - 10, 1, -84)
        content.Position = UDim2.fromOffset(sw + 5, 50)

        configBar.Size     = UDim2.new(1, 0, 0, 28)
        configBar.Position = UDim2.new(0, 0, 1, -28)
    end

    updateSize()
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateSize)

    -- ── Dragging ──────────────────────────────────────────────────────────────
    top.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = inp.Position
            dragPos   = window.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            local d = inp.Position - dragStart
            window.Position = UDim2.new(
                dragPos.X.Scale, dragPos.X.Offset + d.X,
                dragPos.Y.Scale, dragPos.Y.Offset + d.Y
            )
        end
    end)

    -- ── Close / Minimize ──────────────────────────────────────────────────────
    closeBtn.MouseButton1Click:Connect(function()
        Tween(gui, { }, 0.1)
        gui:Destroy()
    end)

    minimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        sidebar.Visible  = not minimized
        content.Visible  = not minimized
        configBar.Visible = not minimized

        if minimized then
            window.Size = UDim2.fromOffset(window.AbsoluteSize.X, 46)
        else
            updateSize()
        end
    end)

    -- ── Notifications ─────────────────────────────────────────────────────────
    local function notify(text, ntype, dur)
        ntype = ntype or "info"
        dur   = dur   or 3

        -- find free slot
        local slot = 1
        while notifSlots[slot] do slot = slot + 1 end
        notifSlots[slot] = true

        local colors = {
            info    = Theme.Info,
            success = Theme.Success,
            warning = Theme.Warning,
            error   = Theme.Error,
        }
        local icons = {
            info    = "ℹ",
            success = "✓",
            warning = "⚠",
            error   = "✗",
        }

        local accentColor = colors[ntype] or Theme.Info

        local nf = New("Frame", {
            Size             = UDim2.fromOffset(255, 56),
            Position         = UDim2.new(1, 10, 1, -70 - (slot - 1) * 64),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel  = 0,
            ZIndex           = 100,
        }, gui)
        Corner(nf, 8)
        Stroke(nf, accentColor, 1)

        New("Frame", {
            Size             = UDim2.fromOffset(3, 36),
            Position         = UDim2.fromOffset(7, 10),
            BackgroundColor3 = accentColor,
            BorderSizePixel  = 0,
            ZIndex           = 101,
        }, nf)
        Corner(_, 2)

        New("TextLabel", {
            Size               = UDim2.fromOffset(20, 56),
            Position           = UDim2.fromOffset(14, 0),
            BackgroundTransparency = 1,
            Text               = icons[ntype] or "•",
            TextColor3         = accentColor,
            TextSize           = 13,
            Font               = Enum.Font.GothamBold,
            ZIndex             = 101,
        }, nf)

        New("TextLabel", {
            Size               = UDim2.new(1, -40, 1, 0),
            Position           = UDim2.fromOffset(36, 0),
            BackgroundTransparency = 1,
            Text               = text,
            TextColor3         = Theme.Text,
            TextSize           = 10,
            Font               = Enum.Font.GothamMedium,
            TextXAlignment     = Enum.TextXAlignment.Left,
            TextWrapped        = true,
            ZIndex             = 101,
        }, nf)

        -- slide in
        Tween(nf, { Position = UDim2.new(1, -263, 1, -70 - (slot - 1) * 64) })

        task.delay(dur, function()
            if nf and nf.Parent then
                Tween(nf, { Position = UDim2.new(1, 10, 1, -70 - (slot - 1) * 64) })
                task.wait(0.22)
                if nf and nf.Parent then nf:Destroy() end
                notifSlots[slot] = nil
            end
        end)

        return nf
    end

    -- ── Config callbacks (collected from tabs) ─────────────────────────────────
    local configCallbacks = {}  -- name -> { get, set }

    local function doSave()
        local data = {}
        for key, fns in pairs(configCallbacks) do
            data[key] = fns.get()
        end
        if saveConfig(configName, data) then
            notify("Config saved: " .. configName, "success")
        else
            notify("Could not save config (no filesystem access)", "warning")
        end
    end

    local function doLoad()
        local data = loadConfig(configName)
        if not data then
            notify("No saved config found: " .. configName, "warning")
            return
        end
        for key, fns in pairs(configCallbacks) do
            if data[key] ~= nil then
                fns.set(data[key])
            end
        end
        notify("Config loaded: " .. configName, "success")
    end

    local function doReset()
        configData = {}
        for key, fns in pairs(configCallbacks) do
            if fns.default ~= nil then
                fns.set(fns.default)
            end
        end
        notify("Config reset to defaults", "info")
    end

    saveBtn.MouseButton1Click:Connect(doSave)
    loadBtn.MouseButton1Click:Connect(doLoad)
    resetBtn.MouseButton1Click:Connect(doReset)

