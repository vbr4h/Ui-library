        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        Parent = ScreenGui,
    })

    newInstance("UICorner", {
        CornerRadius = CORNER,
        Parent = Main,
    })

    newInstance("UIStroke", {
        Color = theme.Accent,
        Thickness = 1.5,
        Transparency = 0.5,
        Parent = Main,
    })

    local Shadow = newInstance("ImageLabel", {
        Name = "Shadow",
        Size = UDim2.new(1, 30, 1, 30),
        Position = UDim2.new(0, -15, 0, -15),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5554236805",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.6,
        ZIndex = 0,
        Parent = Main,
    })

    local Header = newInstance("Frame", {
        Size = UDim2.new(1, 0, 0, HEADER_H),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0,
        Parent = Main,
    })

    newInstance("UICorner", {
        CornerRadius = CORNER,
        Parent = Header,
    })

    newInstance("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0,
        Parent = Header,
    })

    local AccentBar = newInstance("Frame", {
        Size = UDim2.new(0, 3, 0.55, 0),
        Position = UDim2.new(0, 12, 0.225, 0),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Parent = Header,
    })

    newInstance("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = AccentBar,
    })

    newInstance("TextLabel", {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = mobile and 14 or 16,
        TextColor3 = theme.Text,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 24, 0, 0),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header,
    })

    local CloseBtn = newInstance("TextButton", {
        Text = "✕",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = theme.TextMuted,
        Size = UDim2.new(0, 32, 0, 32),
        Position = UDim2.new(1, -38, 0.5, -16),
        BackgroundColor3 = theme.Surface2,
