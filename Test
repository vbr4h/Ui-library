        local notificationTitle = tostring(title)
        local notificationMessage
        local notificationDuration = duration or 4

        if typeof(data) == "table" then
            notificationType = tostring(data.Type or data.type or "Info")
            notificationTitle = tostring(data.Title or data.title or notificationTitle)
            notificationMessage = tostring(data.Content or data.Message or data.Text or "")
            notificationDuration = tonumber(data.Duration or data.duration) or 4
        else
            notificationMessage = tostring(message or data or "")
        end

        notificationType = notificationType:sub(1, 1):upper() .. notificationType:sub(2):lower()

        local typeColors = {
            Info = self._theme.Info,
            Success = self._theme.Success,
            Warning = self._theme.Warning,
            Error = self._theme.Danger
        }

        local accent = typeColors[notificationType] or self._theme.Accent

        local notification = Base("Frame", {
            Name = "Notification",
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = self._theme.Surface,
            BackgroundTransparency = 0.04,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 101,
            Parent = notificationHolder
        })

        Corner(notification, 11)
        Stroke(notification, self._theme.Border, 1, 0.15)

        local accentBar = Base("Frame", {
            Size = UDim2.new(0, 3, 1, -18),
            Position = UDim2.new(0, 7, 0, 9),
            BackgroundColor3 = accent,
            BorderSizePixel = 0,
            ZIndex = 102,
            Parent = notification
        })

        Corner(accentBar, 3)

        local notificationTitleLabel = Base("TextLabel", {
            Size = UDim2.new(1, -38, 0, 20),
            Position = UDim2.new(0, 22, 0, 10),
            BackgroundTransparency = 1,
            Text = notificationTitle,
            TextColor3 = self._theme.Text,
            TextSize = 13,
            Font = self._theme.FontSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 102,
            Parent = notification
        })

        local notificationMessageLabel = Base("TextLabel", {
            Size = UDim2.new(1, -38, 0, 32),
            Position = UDim2.new(0, 22, 0, 31),
            BackgroundTransparency = 1,
            Text = notificationMessage,
            TextColor3 = self._theme.TextMuted,
            TextSize = 11,
            Font = self._theme.Font,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 102,
            Parent = notification
        })

        local close = Base("TextButton", {
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(1, -29, 0, 8),
            BackgroundTransparency = 1,
            Text = "×",
            TextColor3 = self._theme.TextMuted,
            TextSize = 16,
            Font = self._theme.FontMedium,
            AutoButtonColor = false,
            ZIndex = 103,
            Parent = notification
        })

        local function remove()
            if not notification.Parent then
                return
            end

            Tween(notification, {
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1
            }, 0.2)

            task.delay(0.22, function()
                if notification.Parent then
                    notification:Destroy()
                end
            end)
        end

        close.MouseButton1Click:Connect(remove)

        notification.Size = UDim2.new(1, 0, 0, 0)
        Tween(notification, {
            Size = UDim2.new(1, 0, 0, 76)
        }, 0.25, Enum.EasingStyle.Back)

        task.delay(math.max(0.5, notificationDuration), remove)

        return self
    end

    function win:Notification(data, message, duration)
        return self:Notify(data, message, duration)
    end

    function win:Toggle()
        if self._minimized then
            return self:Restore()
        end

        self._screenGui.Enabled = not self._screenGui.Enabled
        return self
    end

    function win:Minimize()
        if self._minimized or self._destroyed then
            return self
        end

        self._minimized = true

        Tween(body, {
            Size = UDim2.new(1, 0, 0, 0)
        }, 0.22)

        Tween(frame, {
            Size = UDim2.new(1, 0, 0, 72)
        }, 0.22)

        return self
    end

    function win:Restore()
        if not self._minimized or self._destroyed then
            return self
        end

        self._minimized = false

        Tween(frame, {
            Size = UDim2.new(1, 0, 1, 0)
        }, 0.25, Enum.EasingStyle.Quart)

        task.delay(0.05, function()
            if not self._destroyed then
                Tween(body, {
                    Size = UDim2.new(1, 0, 1, -72)
                }, 0.25, Enum.EasingStyle.Quart)
            end
        end)

        return self
    end

