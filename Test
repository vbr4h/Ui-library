local function New(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, parent)
end

local function Stroke(parent, color, thickness)
    return New("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1
    }, parent)
end

local function Padding(parent, top, right, bottom, left)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft = UDim.new(0, left or 0)
    }, parent)
end

local function Tween(object, properties, duration, style, direction)
    TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.18,
            style or Enum.EasingStyle.Quart,
            direction or Enum.EasingDirection.Out
        ),
        properties
    ):Play()
end

local function IsMobile()
    return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

local function ColorToHex(color)
    return string.format(
        "%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

local function HexToColor(hex)
    if type(hex) ~= "string" then
        return nil
    end

    hex = hex:gsub("#", "")

    if #hex ~= 6 then
        return nil
    end

    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)

    if not r or not g or not b then
        return nil
    end

    return Color3.fromRGB(r, g, b)
end

local Filesystem = {}

function Filesystem.Read(path)
    if not readfile or not isfile then
        return nil
    end

    local ok, result = pcall(function()
        if not isfile(path) then
            return nil
        end

        return readfile(path)
    end)

    return ok and result or nil
end

function Filesystem.Write(path, data)
    if not writefile then
        return false
    end

    local ok = pcall(writefile, path, data)
    return ok
end

function Filesystem.Delete(path)
    if not delfile then
        return false
    end

    local ok = pcall(delfile, path)
    return ok
end

function Filesystem.Exists(path)
    if not isfile then
        return false
    end

    local ok, result = pcall(isfile, path)
    return ok and result or false
end

function Filesystem.MakeFolder(path)
    if not makefolder or not isfolder then
        return false
    end

    if isfolder(path) then
        return true
    end

    local ok = pcall(makefolder, path)
    return ok
end

function Filesystem.List(path)
    if not listfiles or not isfolder then
        return {}
    end

    if not isfolder(path) then
        return {}
    end

    local ok, result = pcall(listfiles, path)
    return ok and result or {}
end

local ConfigSystem = {}
ConfigSystem.__index = ConfigSystem

local CONFIG_VERSION = 2
local CONFIG_FOLDER = "NebulaUI/configs/"

function ConfigSystem.new(options)
    options = options or {}

    local self = setmetatable({}, ConfigSystem)

    self.Folder = options.Folder or CONFIG_FOLDER
    self.Controls = {}
    self.Modules = {}
    self.Active = nil
    self.AutoLoad = options.AutoLoad
    self.Default = options.Default
    self.OnLoad = options.OnLoad
    self.OnSave = options.OnSave

    Filesystem.MakeFolder("NebulaUI")
    Filesystem.MakeFolder(self.Folder)

    return self
end

function ConfigSystem:_path(name)
    return self.Folder .. name .. ".json"
end

function ConfigSystem:_read(name)
    local raw = Filesystem.Read(self:_path(name))

    if not raw then
        return nil
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    return data
end

function ConfigSystem:_collect()
    local controls = {}
    local modules = {}

    for id, control in pairs(self.Controls) do
        local ok, value = pcall(control.Get)

        if ok then
            controls[id] = value
        end
    end

    for id, module in pairs(self.Modules) do
        local ok, value = pcall(module.Get)

        if ok and type(value) == "table" then
            modules[id] = value
        end
    end

    return controls, modules
end

function ConfigSystem:_payload(name)
    local controls, modules = self:_collect()
    local existing = self:_read(name)

    return {
        __meta = {
            name = name,
            created = existing and existing.__meta and existing.__meta.created or os.time(),
            saved = os.time(),
            version = CONFIG_VERSION
        },
        controls = controls,
        modules = modules
    }
end

function ConfigSystem:RegisterControl(id, controlType, getter, setter, default)
    if type(id) ~= "string" or id == "" then
        return nil
    end

    if type(getter) ~= "function" or type(setter) ~= "function" then
        return nil
    end

    self.Controls[id] = {
        Type = controlType or "custom",
        Get = getter,
        Set = setter,
        Default = default
    }

    return id
end

function ConfigSystem:UnregisterControl(id)
    self.Controls[id] = nil
end

function ConfigSystem:RegisterModule(id, getter, setter)
    if type(id) ~= "string" or id == "" then
        return nil
    end

    if type(getter) ~= "function" or type(setter) ~= "function" then
        return nil
    end

    self.Modules[id] = {
        Get = getter,
        Set = setter
    }

    return id
end

function ConfigSystem:UnregisterModule(id)
    self.Modules[id] = nil
end

function ConfigSystem:CreateConfig(name)
    if type(name) ~= "string" then
        return false, "Invalid config name."
    end

    name = name:match("^%s*(.-)%s*$")

    if name == "" then
        return false, "Config name cannot be empty."
    end

    if Filesystem.Exists(self:_path(name)) then
        return false, "Config already exists."
    end

    Filesystem.MakeFolder("NebulaUI")
    Filesystem.MakeFolder(self.Folder)

    local data = self:_payload(name)

    local ok = Filesystem.Write(
        self:_path(name),
        HttpService:JSONEncode(data)
    )

    if not ok then
        return false, "Filesystem write failed."
    end

    self.Active = name

    return true
end

function ConfigSystem:SaveConfig(name)
    if type(name) ~= "string" then
        return false, "Invalid config name."
    end

    name = name:match("^%s*(.-)%s*$")

    if name == "" then
        return false, "Config name cannot be empty."
    end

    Filesystem.MakeFolder("NebulaUI")
    Filesystem.MakeFolder(self.Folder)

    local data = self:_payload(name)

    local ok = Filesystem.Write(
        self:_path(name),
        HttpService:JSONEncode(data)
    )

    if not ok then
        return false, "Filesystem write failed."
    end

    self.Active = name

    if self.OnSave then
        pcall(self.OnSave, name)
    end

    return true
end

function ConfigSystem:LoadConfig(name)
    if type(name) ~= "string" or name == "" then
        return false, "Invalid config name."
    end

    local data = self:_read(name)

    if not data then
        return false, "Config not found or corrupted."
    end

    local controls = data.controls or {}

    for id, value in pairs(controls) do
        local control = self.Controls[id]

        if control then
            pcall(control.Set, value)
        end
    end

    local modules = data.modules or {}

    for id, value in pairs(modules) do
        local module = self.Modules[id]

        if module then
            pcall(module.Set, value)
        end
    end

    self.Active = name

    if self.OnLoad then
        pcall(self.OnLoad, name)
    end

    return true
end

function ConfigSystem:DeleteConfig(name)
    if type(name) ~= "string" or name == "" then
        return false, "Invalid config name."
    end

    if not Filesystem.Exists(self:_path(name)) then
        return false, "Config does not exist."
    end

    local ok = Filesystem.Delete(self:_path(name))

    if ok and self.Active == name then
        self.Active = nil
    end

    return ok, ok and nil or "Failed to delete config."
end

function ConfigSystem:RenameConfig(oldName, newName)
    if type(oldName) ~= "string" or type(newName) ~= "string" then
        return false, "Invalid config name."
    end

    newName = newName:match("^%s*(.-)%s*$")

    if newName == "" then
        return false, "New name cannot be empty."
    end

    local data = self:_read(oldName)

    if not data then
        return false, "Source config not found."
    end

    if Filesystem.Exists(self:_path(newName)) then
        return false, "A config with that name already exists."
    end

    data.__meta = data.__meta or {}
    data.__meta.name = newName
    data.__meta.saved = os.time()
    data.__meta.version = CONFIG_VERSION

    local ok = Filesystem.Write(
        self:_path(newName),
        HttpService:JSONEncode(data)
    )

    if not ok then
        return false, "Filesystem write failed."
    end

    Filesystem.Delete(self:_path(oldName))

    if self.Active == oldName then
        self.Active = newName
    end

    return true
end

function ConfigSystem:GetConfigs()
    local result = {}

    for _, path in ipairs(Filesystem.List(self.Folder)) do
        local name = path:match("([^/\\]+)%.json$")

        if name then
            local data = self:_read(name)
            local meta = data and data.__meta or {}

            table.insert(result, {
                Name = name,
                Saved = meta.saved or 0,
                Created = meta.created or 0,
                Controls = data and data.controls or {},
                Modules = data and data.modules or {}
            })
        end
    end

    table.sort(result, function(a, b)
        return a.Saved > b.Saved
    end)

    return result
end

function ConfigSystem:GetActive()
    return self.Active
end

function ConfigSystem:GetPreview(name)
    local data = self:_read(name)

    if not data then
        return nil
    end

    local controlCount = 0
    local moduleCount = 0

    for _ in pairs(data.controls or {}) do
        controlCount += 1
    end

    for _ in pairs(data.modules or {}) do
        moduleCount += 1
    end

    return {
        Name = name,
        Saved = data.__meta and data.__meta.saved or 0,
        Created = data.__meta and data.__meta.created or 0,
        ControlCount = controlCount,
        ModuleCount = moduleCount
    }
end

function ConfigSystem:ResetToDefault()
    if self.Default and Filesystem.Exists(self:_path(self.Default)) then
        return self:LoadConfig(self.Default)
    end

    for _, control in pairs(self.Controls) do
        if control.Default ~= nil then
            pcall(control.Set, control.Default)
        end
    end

    return true
end

function ConfigSystem:ExportConfig(name)
    local data = self:_read(name)

    if not data then
        return nil, "Config not found."
    end

    return HttpService:JSONEncode(data)
end

function ConfigSystem:ImportConfig(json, overrideName)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(json)
    end)

    if not ok or type(data) ~= "table" then
        return false, "Invalid JSON."
    end

    local name = overrideName or data.__meta and data.__meta.name or "Imported"
    name = tostring(name):match("^%s*(.-)%s*$")

    if name == "" then
        name = "Imported"
    end

    local finalName = name
    local suffix = 1

    while Filesystem.Exists(self:_path(finalName)) do
        suffix += 1
        finalName = name .. "_" .. suffix
    end

    data.__meta = data.__meta or {}
    data.__meta.name = finalName
    data.__meta.saved = os.time()
    data.__meta.version = CONFIG_VERSION

    local wrote = Filesystem.Write(
        self:_path(finalName),
        HttpService:JSONEncode(data)
    )

    if not wrote then
        return false, "Filesystem write failed."
    end

    return true, finalName
end

