local UI = {}
UI.__index = UI

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Theme = {
    Background = Color3.fromRGB(12, 13, 17),
    Sidebar = Color3.fromRGB(16, 17, 22),
    Surface = Color3.fromRGB(19, 20, 26),
    Element = Color3.fromRGB(25, 26, 33),
    Border = Color3.fromRGB(42, 43, 52),
    Text = Color3.fromRGB(238, 239, 244),
    SubText = Color3.fromRGB(135, 137, 148),
    Accent = Color3.fromRGB(235, 35, 65),
    AccentDark = Color3.fromRGB(75, 20, 30)
}

local function New(class, properties, parent)
    local object = Instance.new(class)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function Corner(parent, radius)
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, parent)
end

local function Stroke(parent, transparency)
    return New("UIStroke", {
        Color = Theme.Border,
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function Tween(object, properties, duration)
    TweenService:Create(
        object,
        TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    ):Play()
end

function UI:CreateWindow(options)
    options = options or {}

    local player = Players.LocalPlayer

    local gui = New("ScreenGui", {
        Name = "NebulaUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, player:WaitForChild("PlayerGui"))

    local shadow = New("Frame", {
        Size = UDim2.fromOffset(782, 512),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.45,
        BorderSizePixel = 0
    }, gui)
    Corner(shadow, 14)

    local window = New("Frame", {
        Size = UDim2.fromOffset(760, 490),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0
    }, gui)
    Corner(window, 13)
    Stroke(window)

    local top = New("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0
    }, window)
    Corner(top, 13)

    New("Frame", {
        Size = UDim2.new(1, -2, 0, 1),
        Position = UDim2.fromOffset(1, 57),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, window)

    local icon = New("TextLabel", {
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.fromOffset(14, 10),
        BackgroundColor3 = Theme.AccentDark,
        Text = "N",
        TextColor3 = Theme.Accent,
        TextSize = 19,
        Font = Enum.Font.GothamBold
    }, top)
    Corner(icon, 9)

    New("TextLabel", {
        Size = UDim2.fromOffset(250, 25),
        Position = UDim2.fromOffset(62, 9),
        BackgroundTransparency = 1,
        Text = options.Title or "Nebula",
        TextColor3 = Theme.Text,
        TextSize = 17,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, top)

    New("TextLabel", {
        Size = UDim2.fromOffset(250, 18),
        Position = UDim2.fromOffset(62, 30),
        BackgroundTransparency = 1,
        Text = options.Subtitle or "Script Hub",
        TextColor3 = Theme.SubText,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, top)

    local minimize = New("TextButton", {
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.new(1, -82, 0, 10),
        BackgroundTransparency = 1,
        Text = "—",
        TextColor3 = Theme.SubText,
        TextSize = 18,
        Font = Enum.Font.GothamBold
    }, top)

    local close = New("TextButton", {
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.new(1, -44, 0, 10),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = Theme.SubText,
        TextSize = 21,
        Font = Enum.Font.Gotham
    }, top)

    local sidebar = New("Frame", {
        Size = UDim2.new(0, 185, 1, -59),
        Position = UDim2.fromOffset(0, 59),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, window)

    local sidePadding = New("UIPadding", {
        PaddingTop = UDim.new(0, 13),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10)
    }, sidebar)

    local tabLayout = New("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, sidebar)

    local content = New("Frame", {
        Size = UDim2.new(1, -200, 1, -74),
        Position = UDim2.fromOffset(195, 69),
        BackgroundTransparency = 1
    }, window)

    local pages = {}
    local currentPage

    local Window = {}

    function Window:Tab(name, tabIcon)
        local button = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 41),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0
        }, sidebar)
        Corner(button, 8)

        local indicator = New("Frame", {
            Size = UDim2.fromOffset(3, 21),
            Position = UDim2.new(0, 0, 0.5, -10),
            BackgroundColor3 = Theme.Accent,
            Visible = false,
            BorderSizePixel = 0
        }, button)
        Corner(indicator, 3)

        New("TextLabel", {
            Size = UDim2.fromOffset(28, 41),
            Position = UDim2.fromOffset(10, 0),
            BackgroundTransparency = 1,
            Text = tabIcon or "•",
            TextColor3 = Theme.SubText,
            TextSize = 16,
            Font = Enum.Font.GothamBold
        }, button)

        local label = New("TextLabel", {
            Size = UDim2.new(1, -48, 1, 0),
            Position = UDim2.fromOffset(40, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Theme.SubText,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left
        }, button)

        local page = New("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false
        }, content)

        local pagePadding = New("UIPadding", {
            PaddingRight = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, 8)
        }, page)

        local layout = New("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, page)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 15)
        end)

        local tab = {
            Page = page,
            Button = button
        }

        function tab:Section(title)
            local section = New("Frame", {
                Size = UDim2.new(1, 0, 0, 45),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0
            }, page)
            Corner(section, 9)
            Stroke(section)

            local sectionTitle = New("TextLabel", {
                Size = UDim2.new(1, -22, 0, 45),
                Position = UDim2.fromOffset(11, 0),
                BackgroundTransparency = 1,
                Text = title,
                TextColor3 = Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, section)

            local elements = New("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.fromOffset(0, 45),
                BackgroundTransparency = 1
            }, section)

            local elementLayout = New("UIListLayout", {
                Padding = UDim.new(0, 1)
            }, elements)

            local function Resize()
                local height = elementLayout.AbsoluteContentSize.Y
                section.Size = UDim2.new(1, 0, 0, 45 + height)
            end

            elementLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(Resize)

            local Section = {}

            function Section:Label(text)
                local item = New("TextLabel", {
                    Size = UDim2.new(1, -22, 0, 32),
                    Position = UDim2.fromOffset(11, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Theme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, elements)
                return item
            end

            function Section:Button(text, callback)
                local item = New("TextButton", {
                    Size = UDim2.new(1, -22, 0, 36),
                    BackgroundColor3 = Theme.Element,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamMedium,
                    AutoButtonColor = false,
                    BorderSizePixel = 0
                }, elements)
                Corner(item, 7)

                item.MouseEnter:Connect(function()
                    Tween(item, {BackgroundColor3 = Color3.fromRGB(32, 33, 41)})
                end)

                item.MouseLeave:Connect(function()
                    Tween(item, {BackgroundColor3 = Theme.Element})
                end)

                item.MouseButton1Click:Connect(function()
                    if callback then
                        callback()
                    end
                end)

                return item
            end

            function Section:Toggle(text, default, callback)
                local enabled = default or false

                local item = New("TextButton", {
                    Size = UDim2.new(1, -22, 0, 40),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    BorderSizePixel = 0
                }, elements)

                New("TextLabel", {
                    Size = UDim2.new(1, -65, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, item)

                local switch = New("Frame", {
                    Size = UDim2.fromOffset(40, 22),
                    Position = UDim2.new(1, -40, 0.5, -11),
                    BackgroundColor3 = Color3.fromRGB(35, 36, 44),
                    BorderSizePixel = 0
                }, item)
                Corner(switch, 11)

                local knob = New("Frame", {
                    Size = UDim2.fromOffset(16, 16),
                    Position = UDim2.fromOffset(3, 3),
                    BackgroundColor3 = Color3.fromRGB(190, 192, 200),
                    BorderSizePixel = 0
                }, switch)
                Corner(knob, 8)

                local function Set(value)
                    enabled = value

                    if enabled then
                        Tween(switch, {BackgroundColor3 = Theme.Accent})
                        Tween(knob, {
                            Position = UDim2.new(1, -19, 0, 3),
                            BackgroundColor3 = Color3.new(1, 1, 1)
                        })
                    else
                        Tween(switch, {BackgroundColor3 = Color3.fromRGB(35, 36, 44)})
                        Tween(knob, {
                            Position = UDim2.fromOffset(3, 3),
                            BackgroundColor3 = Color3.fromRGB(190, 192, 200)
                        })
                    end

                    if callback then
                        callback(enabled)
                    end
                end

                item.MouseButton1Click:Connect(function()
                    Set(not enabled)
                end)

                Set(enabled)

                return {
                    Set = Set,
                    Get = function()
                        return enabled
                    end
                }
            end

            function Section:Slider(text, min, max, default, callback)
                min = min or 0
                max = max or 100
                local value = math.clamp(default or min, min, max)

                local item = New("Frame", {
                    Size = UDim2.new(1, -22, 0, 54),
                    BackgroundTransparency = 1
                }, elements)

                New("TextLabel", {
                    Size = UDim2.new(0.5, 0, 0, 22),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, item)

                local valueLabel = New("TextLabel", {
                    Size = UDim2.new(0.5, 0, 0, 22),
                    Position = UDim2.new(0.5, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(value),
                    TextColor3 = Theme.SubText,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Right
                }, item)

                local bar = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 5),
                    Position = UDim2.fromOffset(0, 32),
                    BackgroundColor3 = Color3.fromRGB(35, 36, 44),
                    BorderSizePixel = 0
                }, item)
                Corner(bar, 4)

                local fill = New("Frame", {
                    Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0
                }, bar)
                Corner(fill, 4)

                local draggingSlider = false

                local function Update(input)
                    local percent = math.clamp(
                        (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                        0,
                        1
                    )

                    value = math.floor(min + ((max - min) * percent))
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    valueLabel.Text = tostring(value)

                    if callback then
                        callback(value)
                    end
                end

                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = true
                        Update(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if draggingSlider and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        Update(input)
                    end
                end)

                return {
                    Set = function(v)
                        value = math.clamp(v, min, max)
                        local percent = (value - min) / (max - min)
                        fill.Size = UDim2.new(percent, 0, 1, 0)
                        valueLabel.Text = tostring(value)
                        if callback then
                            callback(value)
                        end
                    end,
                    Get = function()
                        return value
                    end
                }
            end

            return Section
        end

        button.MouseButton1Click:Connect(function()
            for _, other in ipairs(pages) do
                other.Page.Visible = false
                other.Button.BackgroundTransparency = 1
            end

            page.Visible = true
            button.BackgroundTransparency = 0
            button.BackgroundColor3 = Theme.AccentDark
            indicator.Visible = true
            label.TextColor3 = Theme.Text
            currentPage = page
        end)

        table.insert(pages, tab)

        if #pages == 1 then
            page.Visible = true
            button.BackgroundTransparency = 0
            button.BackgroundColor3 = Theme.AccentDark
            indicator.Visible = true
            label.TextColor3 = Theme.Text
            currentPage = page
        end

        return tab
    end

    local dragging = false
    local dragStart
    local startPosition

    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = window.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            local position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )

            window.Position = position
            shadow.Position = position
        end
    end)

    close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    minimize.MouseButton1Click:Connect(function()
        window.Visible = false
    end)

    return Window
end

return UI
