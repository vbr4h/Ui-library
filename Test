        function Tab:AddDropdown(text, options, callback)
            local selected = options[1] or "Select"
            local open = false

            local Wrapper = newInstance("Frame", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Parent = Scroll,
            })

            local f = newInstance("Frame", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = theme.Surface,
                BorderSizePixel = 0,
                Parent = Wrapper,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(0, 8),
                Parent = f,
            })

            newInstance("TextLabel", {
                Text = text,
                Font = Enum.Font.GothamSemibold,
                TextSize = mobile and 12 or 13,
                TextColor3 = theme.Text,
                Size = UDim2.new(0.45, 0, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = f,
            })

            local SelBtn = newInstance("TextButton", {
                Text = selected .. "  ▾",
                Font = Enum.Font.Gotham,
                TextSize = mobile and 11 or 12,
                TextColor3 = theme.Text,
                BackgroundColor3 = theme.Surface2,
                Size = UDim2.new(0.5, -8, 0, 24),
                Position = UDim2.new(0.5, 0, 0.5, -12),
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Parent = f,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(0, 6),
                Parent = SelBtn,
            })

            local DDFrame = newInstance("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 1, 2),
                BackgroundColor3 = theme.Surface,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                ZIndex = 5,
                Parent = Wrapper,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(0, 8),
                Parent = DDFrame,
            })

            local OptionList = newInstance("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = DDFrame,
            })

            for i, opt in ipairs(options) do
                local OBtn = newInstance("TextButton", {
                    Text = opt,
                    Font = Enum.Font.Gotham,
                    TextSize = mobile and 11 or 12,
                    TextColor3 = theme.Text,
                    BackgroundColor3 = theme.Surface,
                    Size = UDim2.new(1, 0, 0, 28),
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    ZIndex = 6,
                    Parent = DDFrame,
                })

                OBtn.MouseEnter:Connect(function()
                    tween(OBtn, {
                        BackgroundColor3 = theme.Surface2
                    }, 0.1)
                end)

                OBtn.MouseLeave:Connect(function()
                    tween(OBtn, {
                        BackgroundColor3 = theme.Surface
                    }, 0.1)
                end)

                OBtn.MouseButton1Click:Connect(function()
                    selected = opt
                    SelBtn.Text = opt .. "  ▾"
                    open = false

                    tween(DDFrame, {
                        Size = UDim2.new(1, 0, 0, 0)
                    }, 0.15)

                    Wrapper.Size = UDim2.new(1, 0, 0, 36)

                    if callback then
                        pcall(callback, opt)
                    end
                end)
            end

            local totalH = #options * 28

            SelBtn.MouseButton1Click:Connect(function()
                open = not open

                if open then
                    tween(DDFrame, {
                        Size = UDim2.new(1, 0, 0, totalH)
                    }, 0.18)

                    Wrapper.Size = UDim2.new(1, 0, 0, 36 + totalH + 4)
                else
                    tween(DDFrame, {
                        Size = UDim2.new(1, 0, 0, 0)
                    }, 0.15)

                    Wrapper.Size = UDim2.new(1, 0, 0, 36)
                end
            end)

            return Wrapper
        end

        return Tab
    end

    return Window
end

function NebulaUI:Notify(msg, duration)
    duration = duration or 3

    local gui = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui") or
        game:GetService("CoreGui")

    local sg = newInstance("ScreenGui", {
        Name = "NebulaNotif",
        ResetOnSpawn = false,
    })

    pcall(function()
        sg.Parent = game:GetService("CoreGui")
    end)

    if not sg.Parent then
        sg.Parent = gui
    end

    local notif = newInstance("Frame", {
        Size = UDim2.new(0, 260, 0, 42),
        Position = UDim2.new(1, -270, 1, -60),
        BackgroundColor3 = Color3.fromRGB(22, 22, 30),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        Parent = sg,
    })

    newInstance("UICorner", {
        CornerRadius = UDim.new(0, 10),
        Parent = notif,
    })

    newInstance("UIStroke", {
        Color = Color3.fromRGB(120, 80, 240),
        Thickness = 1.2,
        Parent = notif,
    })

    newInstance("TextLabel", {
        Text = msg,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(230, 230, 240),
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif,
    })

    tween(notif, {
        BackgroundTransparency = 0
    }, 0.2)

    task.delay(duration, function()
        tween(notif, {
            BackgroundTransparency = 1
        }, 0.2)

        task.delay(0.25, function()
            sg:Destroy()
        end)
    end)
end

return NebulaUI
