                task.delay(0.12, function()
                    tween(Btn2, {
                        BackgroundColor3 = theme.Accent
                    }, 0.1)
                end)

                if callback then
                    pcall(callback)
                end
            end)

            return f
        end

        function Tab:AddToggle(text, default, callback)
            local value = default or false
            local f = row(36)

            newInstance("TextLabel", {
                Text = text,
                Font = Enum.Font.GothamSemibold,
                TextSize = mobile and 12 or 13,
                TextColor3 = theme.Text,
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = f,
            })

            local Track = newInstance("Frame", {
                Size = UDim2.new(0, 36, 0, 20),
                Position = UDim2.new(1, -46, 0.5, -10),
                BackgroundColor3 = value and theme.Accent or theme.Surface2,
                BorderSizePixel = 0,
                Parent = f,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Track,
            })

            local Knob = newInstance("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = value and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0,
                Parent = Track,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Knob,
            })

            local Hitbox = newInstance("TextButton", {
                Text = "",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Parent = f,
            })

            Hitbox.MouseButton1Click:Connect(function()
                value = not value

                tween(Track, {
                    BackgroundColor3 = value and theme.Accent or theme.Surface2
                }, 0.15)

                tween(Knob, {
                    Position = value and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                }, 0.15)

                if callback then
                    pcall(callback, value)
                end
            end)

            return f
        end

        function Tab:AddSlider(text, min, max, default, callback)
            local value = default or min
            local f = row(50)

            f.Size = UDim2.new(1, 0, 0, 52)

            local Label = newInstance("TextLabel", {
                Text = text .. ": " .. value,
                Font = Enum.Font.GothamSemibold,
                TextSize = mobile and 12 or 13,
                TextColor3 = theme.Text,
                Size = UDim2.new(1, -16, 0, 20),
                Position = UDim2.new(0, 12, 0, 6),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = f,
            })

            local Track = newInstance("Frame", {
                Size = UDim2.new(1, -24, 0, 6),
                Position = UDim2.new(0, 12, 0, 32),
                BackgroundColor3 = theme.Surface2,
                BorderSizePixel = 0,
                Parent = f,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Track,
            })

            local Fill = newInstance("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                Parent = Track,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Fill,
            })

            local Knob2 = newInstance("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                BackgroundColor3 = theme.Text,
                BorderSizePixel = 0,
                Parent = Track,
            })

            newInstance("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Knob2,
            })

            local sliding = false

            local function updateSlider(x)
                local abs = Track.AbsolutePosition.X
                local w = Track.AbsoluteSize.X
                local pct = math.clamp((x - abs) / w, 0, 1)

                value = math.round(min + (max - min) * pct)

                Fill.Size = UDim2.new(pct, 0, 1, 0)
                Knob2.Position = UDim2.new(pct, 0, 0.5, 0)
                Label.Text = text .. ": " .. value

                if callback then
                    pcall(callback, value)
                end
            end

            Track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateSlider(inp.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(inp)
                if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(inp.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            return f
        end

        function Tab:AddTextbox(text, placeholder, callback)
            local f = row(36)

            newInstance("TextLabel", {
                Text = text,
                Font = Enum.Font.GothamSemibold,
                TextSize = mobile and 12 or 13,
                TextColor3 = theme.Text,
                Size = UDim2.new(0.38, -8, 1, 0),
